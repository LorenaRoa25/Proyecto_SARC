rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsResource() {
      return signedIn() && request.auth.uid == resource.data.userId;
    }

    function ownsIncomingResource() {
      return signedIn() && request.auth.uid == request.resource.data.userId;
    }

    match /usuarios/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /cursos/{documentId} {
      allow read, update, delete: if ownsResource();
      allow create: if ownsIncomingResource();
    }

    match /recomendaciones/{documentId} {
      allow read, update, delete: if ownsResource();
      allow create: if ownsIncomingResource();
    }

    match /tareasAsistente/{documentId} {
      allow read, update, delete: if ownsResource();
      allow create: if ownsIncomingResource();
    }
  }
}
